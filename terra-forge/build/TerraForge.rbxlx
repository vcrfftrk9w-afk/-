]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000004"><Properties><string name="Name">Icons</string><ProtectedString name="Source"><![CDATA[-- Generated by tools/gen_data.py from tools/icons.js. Do not edit by hand.
-- Each icon: palette (m/d/l = nation colour, letter = fixed slot colour, #hex = fixed) and
-- base64 pixels, one byte per pixel: high 4 bits = palette index, low 4 bits = alpha (0-15).
return {
	size = 64,
	slots = {
		k = "#1b2029",
		g = "#8e98aa",
		s = "#f2c48d",
		c = "#bfe9ff",
		y = "#ffc23d",
		w = "#b37b45",
		v = "#e9eef4",
		r = "#a3907c",
		o = "#d6773f",
		t = "#cfd6df",
	},
	icons = {
		tank = { palette = { "#0a0d14", "k", "g", "m", "l", "d" }, data = "" },
		infantry = { palette = { "#0a0d14", "k", "m", "d", "s" }, data = "" },
		plane = { palette = { "#0a0d14", "m", "l", "d", "c" }, data = "" },
		artillery = { palette = { "#0a0d14", "k", "d", "m", "l", "g" }, data = "" },
		ship = { palette = { "#0a0d14", "k", "l", "d", "c", "m" }, data = "" },
		mine = { palette = { "#0a0d14", "r", "o", "w", "t" }, data = "" },
		rig = { palette = { "#0a0d14", "d", "t", "m", "k", "v" }, data = "" },
		power = { palette = { "#0a0d14", "v", "t", "m", "y" }, data = "" },
		mill = { palette = { "#0a0d14", "v", "d", "m", "l", "y" }, data = "" },
		barracks = { palette = { "#0a0d14", "m", "l", "k", "y" }, data = "" },
		castle = { palette = { "#0a0d14", "k", "y", "m", "l", "d" }, data = "" },
		city = { palette = { "#0a0d14", "k", "d", "m", "l", "y" }, data = "" },
		tower = { palette = { "#0a0d14", "m", "l", "k", "d" }, data = "" },
		aa = { palette = { "#0a0d14", "k", "g", "m", "d", "l", "o" }, data = "" },
		ore = { palette = { "#0a0d14", "m", "l" }, data = "" },
		drop = { palette = { "#0a0d14", "m", "l" }, data = "" },
		pop = { palette = { "#f2c48d", "#e9eef6", "#5d6b82" }, data = "" },
		iron = { palette = { "#8d98ab", "#c6cfdc", "#6c7689" }, data = "" },
		coal = { palette = { "#3a3d47", "#6b7080" }, data = "" },
		oil = { palette = { "#9aa4b6", "#2a2c37" }, data = "" },
		steel = { palette = { "#a9bbd4", "#e3ecf8" }, data = "" },
		energy = { palette = { "#ffc23d" }, data = "" },
		trophy = { palette = { "#eef2f8", "#ffd27e" }, data = "" },
		exit = { palette = { "#eef2f8" }, data = "" },
		plus = { palette = { "#eef2f8" }, data = "" },
		minus = { palette = { "#eef2f8" }, data = "" },
		close = { palette = { "#eef2f8" }, data = "" },
		help = { palette = { "#eef2f8" }, data = "" },
		play = { palette = { "#2b1203" }, data = "" },
