	sniper = { infantry = 2.6, rocket = 2.6, sniper = 2.6, engineer = 2.6, scout = 0.3, tank = 0.15, heavy = 0.1, artillery = 0.3, mlrs = 0.3, aagun = 0.3 },
	mlrs = { infantry = 1.3, rocket = 1.3, sniper = 1.3, engineer = 1.3 },
}
Config.MAX_UNITS = 240 -- all bases together, to keep the server fast

-- research at the research centre: one study at a time in each centre, paid when it starts and
-- slower when energy is short. armor = share of the damage own units no longer take, damage =
-- share added to the damage of own units and towers, production = share added to the speed of
-- factories, unlocks = a unit that can be ordered once done; needs = research done before
Config.TECH_ORDER = { "armor1", "weapons1", "assembly", "armor2", "weapons2", "heavy" }
Config.TECH = {
	armor1 = { name = "Броня I", icon = "shield", cost = 400, time = 30, armor = 0.15, desc = "Твои войска получают на 15% меньше урона." },
	weapons1 = { name = "Орудия I", icon = "swords", cost = 400, time = 30, damage = 0.15, desc = "Войска и башни бьют на 15% сильнее." },
	assembly = { name = "Конвейер", icon = "gear", cost = 500, time = 35, production = 0.3, desc = "Заводы выпускают войска на 30% быстрее." },
	armor2 = { name = "Броня II", icon = "shield", cost = 700, time = 45, armor = 0.15, needs = "armor1", desc = "Ещё −15% урона: всего −30%." },
	weapons2 = { name = "Орудия II", icon = "swords", cost = 700, time = 45, damage = 0.15, needs = "weapons1", desc = "Ещё +15% урона: всего +30%." },
	heavy = { name = "Тяжёлый танк", icon = "tank", cost = 600, time = 40, unlocks = "heavy", needs = "armor1", desc = "Завод бронетехники сможет собирать тяжёлые танки." },
}

-- what a base's finished research adds up to: armor, damage and production shares
function Config.techBonus(done: { [string]: boolean }?): (number, number, number)
	local armor, damage, production = 0, 0, 0
	for id in done or {} do
		local t = Config.TECH[id]
		if t then
			armor += t.armor or 0
			damage += t.damage or 0
			production += t.production or 0
		end
	end
	return armor, damage, production
end

return Config
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000003"><Properties><string name="Name">Map</string><ProtectedString name="Source"><![CDATA[-- The skirmish map: ground kinds per tile, resource pools and the four base spots.
-- Tiles are numbered 0..N-1, row by row. The picture of the map is made from the same data.
local Base64 = require(script.Parent.Base64)
local MapData = require(script.Parent.MapData)

local W, H = MapData.W, MapData.H
local N = W * H
local readu8 = buffer.readu8

local Map = { W = W, H = H, N = N }
Map.WATER, Map.GRASS, Map.SAND, Map.DIRT, Map.ROCK = 0, 1, 2, 3, 4

-- ground kind per tile: 0 water, 1 grass, 2 sand, 3 dirt, 4 rock
local kind = buffer.create(N)
do
	local rle = Base64.decode(MapData.tiles)
	local p = 0
	for i = 0, buffer.len(rle) - 1 do
		local b = readu8(rle, i)
		local n = b % 32 + 1
		buffer.fill(kind, p, b // 32, n)
		p += n
	end
end

-- top-left tiles of the 2 x 2 resource pools, and the centre tiles of the four bases
Map.pools = {}
for _, p in MapData.pools do
	table.insert(Map.pools, { x = p[1], y = p[2] })
end
-- the ground picture is cut into columns x rows pictures: map0, map1, ... row by row
Map.chunks = MapData.chunks or { 2, 2 }

Map.starts = {}
for _, s in MapData.starts do
	table.insert(Map.starts, { x = s[1], y = s[2] })
end

function Map.neighbors(t: number, out: { number }): number
	local k = 0
	local x = t % W
	if x > 0 then
		k += 1
		out[k] = t - 1
	end
	if x < W - 1 then
		k += 1
		out[k] = t + 1
	end
	if t >= W then
		k += 1
		out[k] = t - W
	end
	if t < N - W then
		k += 1
		out[k] = t + W
	end
	return k
end

function Map.kind(t: number): number
	return readu8(kind, t)
end

-- ground units can drive here: grass, sand or dirt
function Map.isLand(t: number): boolean
	local k = readu8(kind, t)
	return k ~= 0 and k ~= 4
end

function Map.inBounds(x: number, y: number): boolean
	return x >= 0 and y >= 0 and x < W and y < H
end

return Map
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000004"><Properties><string name="Name">MapArt</string><ProtectedString name="Source"><![CDATA[-- Generated by tools/upload_art.py. Do not edit by hand.
-- Decal ids of the game pictures, by name; the server finds the image inside each.
return {
	atlas = 102235042971641,
	map0 = 110132028189260,
	map1 = 101277742776430,
	map2 = 80001096250119,
	map3 = 113972991017728,
	map4 = 121683578658619,
	map5 = 115895249623080,
	team = 124268398470672,
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000005"><Properties><string name="Name">MapData</string><ProtectedString name="Source"><![CDATA[-- Generated by tools/gen_battlemap.py. Do not edit by hand.
-- 112 x 72 tiles. Tiles: run-length encoded, base64, each byte = kind << 5 | (run length - 1);
-- kinds: 0 water, 1 grass, 2 sand, 3 dirt, 4 rock. Pools: top-left tile of each 2 x 2 resource pool.
-- chunks: columns and rows of the ground pictures map0, map1, ... (row by row).
return {
	W = 112,
	H = 72,
	tiles = "",
	starts = { { 11, 10 }, { 100, 10 }, { 11, 61 }, { 100, 61 } },
	pools = { { 17, 6 }, { 93, 6 }, { 17, 64 }, { 93, 64 }, { 6, 18 }, { 104, 18 }, { 6, 52 }, { 104, 52 }, { 26, 15 }, { 84, 15 }, { 26, 55 }, { 84, 55 }, { 33, 27 }, { 77, 27 }, { 33, 43 }, { 77, 43 }, { 45, 21 }, { 65, 21 }, { 45, 49 }, { 65, 49 }, { 24, 30 }, { 86, 30 }, { 24, 40 }, { 86, 40 } },
	chunks = { 3, 2 },
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000006"><Properties><string name="Name">Motion</string><ProtectedString name="Source"><![CDATA[-- Where a unit is at a given time. Units move along a path (flat list x1, y1, x2, y2, ...)
-- at a fixed speed from time t0; planes then circle around the end point.
-- The server and clients use the same function, so only orders need to be sent.
local Motion = {}

function Motion.length(path: { number }): number
	local total = 0
	for i = 1, #path // 2 - 1 do
		local dx, dy = path[2 * i + 1] - path[2 * i - 1], path[2 * i + 2] - path[2 * i]
		total += math.sqrt(dx * dx + dy * dy)
	end
	return total
end

-- returns x, y, arrived, horizontal direction of travel (negative = moving left)
function Motion.position(u, t: number): (number, number, boolean, number)
	local path = u.path
	local count = #path // 2
	local dist = math.max(0, (t - u.t0) * u.speed)
	local travelled = 0
	for i = 1, count - 1 do
		local x1, y1, x2, y2 = path[2 * i - 1], path[2 * i], path[2 * i + 1], path[2 * i + 2]
		local dx, dy = x2 - x1, y2 - y1
		local seg = math.sqrt(dx * dx + dy * dy)
		if dist - travelled <= seg then
			local k = if seg > 0 then (dist - travelled) / seg else 1
			return x1 + dx * k, y1 + dy * k, false, dx
		end
		travelled += seg
	end
	local ex, ey = path[2 * count - 1], path[2 * count]
	local o = u.orbit
	if o then
		local tEnd = u.t0 + travelled / math.max(u.speed, 0.001)
		local a = o.a0 + o.w * (t - tEnd)
		local cx = ex - math.cos(o.a0) * o.r
		local cy = ey - math.sin(o.a0) * o.r * 0.82
		return cx + math.cos(a) * o.r, cy + math.sin(a) * o.r * 0.82, true, -math.sin(a) * o.w
	end
	return ex, ey, true, 0
end

return Motion
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000007"><Properties><string name="Name">SoundData</string><ProtectedString name="Source"><![CDATA[-- Generated by tools/build_sounds.py. Do not edit by hand.
-- All sound effects are in one audio asset; each clip is { start, length } in seconds.
return {
	id = 123184914786591,
	clips = {
		rifle = { 0.2000, 0.5000 },
		mg = { 0.9000, 0.2643 },
		cannon = { 1.3643, 0.8182 },
		tower = { 2.3824, 1.1713 },
		artillery = { 3.7537, 0.6000 },
		rocket = { 4.5537, 1.0000 },
		flak = { 5.7537, 0.8796 },
		boom = { 6.8334, 0.7775 },
		bigboom = { 7.8108, 2.6000 },
		build = { 10.6108, 0.6273 },
		hammer = { 11.4381, 0.2865 },
		built = { 11.9246, 0.5390 },
		ready = { 12.6636, 0.2898 },
		click = { 13.1534, 0.0404 },
		order = { 13.3938, 0.1882 },
		error = { 13.7820, 0.1045 },
