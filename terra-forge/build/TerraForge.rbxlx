-- extra damage multipliers: attacker kind -> target kind
Config.VS = {
	infantry = { tank = 0.5, heavy = 0.4, scout = 0.7, mlrs = 0.7, aagun = 0.7 },
	rocket = { tank = 1.8, heavy = 1.8, scout = 1.5, mlrs = 1.6, aagun = 1.6, infantry = 0.6, sniper = 0.6 },
