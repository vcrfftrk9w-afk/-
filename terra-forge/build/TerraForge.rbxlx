		cost = 500,
		time = 14,
		hp = 500,
		income = 2,
		desc = "Больше людей: +1500 к пределу войск, быстрее их прирост и +2 $/с.",
	},
	barracks = {
		name = "Казарма",
		icon = "barracks",
		cost = 250,
		time = 8,
		hp = 400,
		units = { "infantry", "rocket" },
		desc = "Обучает пехоту и ракетчиков. Нажми на неё на карте, чтобы заказать.",
	},
	tankf = {
		name = "Танковый завод",
		icon = "tank",
