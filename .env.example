# Ключ к Claude API. Без него редактор работает на встроенном разборе фраз.
ANTHROPIC_API_KEY=

# Модель-планировщик.
PLANNER_MODEL=claude-opus-5

# Порт HTTP-сервера.
PORT=3000

# Ограничения загрузки.
MAX_UPLOAD_MB=512
MAX_ASSETS=40

# Сколько часов хранить проект и его файлы после последнего обращения.
PROJECT_TTL_HOURS=12

# Шрифт титров (имя из fontconfig). По умолчанию DejaVu Sans — в нём есть кириллица.
CAPTION_FONT=DejaVu Sans

# Свои сборки ffmpeg/ffprobe вместо тех, что тянет npm.
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
