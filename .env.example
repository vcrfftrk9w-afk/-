# ── AI (мозг приложения) ────────────────────────────────────────────────
# Ключ Claude API: https://console.anthropic.com/  → API Keys
# Без ключа приложение работает на встроенном офлайн-движке (правила + база знаний).
ANTHROPIC_API_KEY=
# Модель (по умолчанию claude-opus-5)
ANTHROPIC_MODEL=claude-opus-5

# ── Официальный вход через TikTok (Login Kit + Display API) ──────────────
# 1. https://developers.tiktok.com/ → Manage apps → Create app
# 2. Добавь продукты "Login Kit" и "Display API"
# 3. Scopes: user.info.basic, user.info.profile, user.info.stats, video.list
# 4. Redirect URI: http://localhost:3000/api/tiktok/callback  (или твой домен)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3000/api/tiktok/callback
