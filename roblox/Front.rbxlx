-- уведомления (слева, под статистикой)
local feed = frame(gui, { Size = UDim2.fromOffset(300, 10), Position = UDim2.fromOffset(10, 108), BackgroundTransparency = 1, AutomaticSize = Enum.AutomaticSize.Y })
