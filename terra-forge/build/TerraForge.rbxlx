<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4"><External>null</External><External>nil</External><Item class="ReplicatedStorage" referent="RBX00000009"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX00000008"><Properties><string name="Name">TerraForge</string></Properties><Item class="ModuleScript" referent="RBX00000001"><Properties><string name="Name">Base64</string><ProtectedString name="Source"><![CDATA[-- Standard base64 decoding into a buffer (used for the map and icon data).
local Base64 = {}

local ALPHABET = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local lookup = {}
for i = 1, 64 do
	lookup[string.byte(ALPHABET, i)] = i - 1
end

function Base64.decode(s: string): buffer
	local len = #s
	local pad = 0
	if string.sub(s, -2) == "==" then
		pad = 2
	elseif string.sub(s, -1) == "=" then
		pad = 1
	end
	local outLen = (len // 4) * 3 - pad
	local out = buffer.create(outLen)
	local o = 0
	for i = 1, len, 4 do
		local a, b, c, d = string.byte(s, i, i + 3)
		local n = (lookup[a] or 0) * 262144 + (lookup[b] or 0) * 4096 + (lookup[c] or 0) * 64 + (lookup[d] or 0)
		if o < outLen then
			buffer.writeu8(out, o, n // 65536)
		end
		if o + 1 < outLen then
			buffer.writeu8(out, o + 1, (n // 256) % 256)
		end
		if o + 2 < outLen then
			buffer.writeu8(out, o + 2, n % 256)
		end
		o += 3
	end
	return out
end

return Base64
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000002"><Properties><string name="Name">Codec</string><ProtectedString name="Source"><![CDATA[-- Compact network formats for territory data.
-- Snapshot: u32 run count, then runs of (u16 owner, u16 length) over all tiles.
-- Delta: one u32 per change = tile + owner * 2^18 (tiles fit in 18 bits).
local Codec = {}

local TILE_BITS = 262144

function Codec.encodeOwners(owner: buffer, n: number): buffer
	local runs = {}
	local cur = buffer.readu16(owner, 0)
	local len = 0
	for t = 0, n - 1 do
		local o = buffer.readu16(owner, t * 2)
		if o == cur and len < 65535 then
			len += 1
		else
			table.insert(runs, cur)
			table.insert(runs, len)
			cur = o
			len = 1
		end
	end
	table.insert(runs, cur)
	table.insert(runs, len)
	local count = #runs // 2
	local out = buffer.create(4 + count * 4)
	buffer.writeu32(out, 0, count)
	for i = 1, count do
		local at = 4 + (i - 1) * 4
		buffer.writeu16(out, at, runs[2 * i - 1])
		buffer.writeu16(out, at + 2, runs[2 * i])
	end
	return out
end

-- calls visit(tile, owner) for every tile that has an owner
function Codec.decodeOwners(data: buffer, visit: (number, number) -> ())
	local count = buffer.readu32(data, 0)
	local t = 0
	for i = 0, count - 1 do
		local o = buffer.readu16(data, 4 + i * 4)
		local len = buffer.readu16(data, 6 + i * 4)
		if o ~= 0 then
			for k = 0, len - 1 do
				visit(t + k, o)
			end
		end
		t += len
	end
end

function Codec.packChanges(changes: { number }): buffer
	local out = buffer.create(#changes * 4)
	for i, v in changes do
		buffer.writeu32(out, (i - 1) * 4, v)
	end
	return out
end

function Codec.change(tile: number, owner: number): number
	return owner * TILE_BITS + tile
end

-- calls visit(tile, owner) for every change in order
function Codec.readChanges(data: buffer, visit: (number, number) -> ())
	for i = 0, buffer.len(data) // 4 - 1 do
		local v = buffer.readu32(data, i * 4)
		visit(v % TILE_BITS, v // TILE_BITS)
	end
end

return Codec
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000003"><Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[-- Game rules and content shared by the server and the client.
