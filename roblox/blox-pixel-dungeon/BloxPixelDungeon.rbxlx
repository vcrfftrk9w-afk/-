				</Item>
				<Item class="Folder" referent="RBX00000000000000000000000000000018">
					<Properties>
						<string name="Name">Modules</string>
					</Properties>
					<Item class="ModuleScript" referent="RBX00000000000000000000000000000015">
						<Properties>
							<string name="Name">Hud</string>
							<ProtectedString name="Source"><![CDATA[-- Интерфейс поверх подземелья: здоровье и опыт, журнал, панель кнопок,
-- рюкзак и окна предметов. Похоже на панели Shattered Pixel Dungeon.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("BPD")
local Defs = require(Shared:WaitForChild("Core"):WaitForChild("Defs"))
local Ui = require(script.Parent:WaitForChild("Ui"))

local Hud = {}
Hud.__index = Hud

local LOG_LINES = 5

function Hud.new(gui, on)
	local self = setmetatable({ gui = gui, on = on, lines = {} }, Hud)
	local root = Ui.new("Frame", {
		Name = "Hud",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 10,
		Parent = gui,
	})
	self.root = root
	local safe = Ui.new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = root })
	Ui.new("UIPadding", {
		PaddingTop = UDim.new(0, 44),
		PaddingLeft = UDim.new(0, 10),
		PaddingRight = UDim.new(0, 10),
		PaddingBottom = UDim.new(0, 10),
		Parent = safe,
	})

	-- статус героя
	local status = Ui.panel(safe, { Size = UDim2.fromOffset(250, 70), BackgroundTransparency = 0.1 })
	self.portrait = Ui.image(status, { Position = UDim2.fromOffset(8, 6), Size = UDim2.fromOffset(36, 45) })
	self.title = Ui.label(status, "Воин", 15, {
		Position = UDim2.fromOffset(52, 4),
		Size = UDim2.fromOffset(190, 18),
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	local hpBack = Ui.new("Frame", {
		BackgroundColor3 = Ui.C.hpBack,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(52, 24),
		Size = UDim2.fromOffset(188, 16),
		Parent = status,
	})
	Ui.corner(hpBack, 3)
	self.hpFill = Ui.new("Frame", { BackgroundColor3 = Ui.C.hp, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), Parent = hpBack })
	Ui.corner(self.hpFill, 3)
	self.hpText = Ui.label(hpBack, "20/20", 13, { Size = UDim2.fromScale(1, 1), TextStrokeTransparency = 0.4, ZIndex = 2 })
	local expBack = Ui.new("Frame", {
		BackgroundColor3 = Color3.fromRGB(60, 55, 30),
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(52, 43),
		Size = UDim2.fromOffset(188, 4),
		Parent = status,
	})
	self.expFill = Ui.new("Frame", { BackgroundColor3 = Ui.C.exp, BorderSizePixel = 0, Size = UDim2.fromScale(0, 1), Parent = expBack })
	self.info = Ui.label(status, "", 13, {
		Position = UDim2.fromOffset(52, 49),
		Size = UDim2.fromOffset(190, 16),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Ui.C.dim,
	})
	self.buffs = Ui.label(safe, "", 13, {
		Position = UDim2.fromOffset(4, 74),
		Size = UDim2.fromOffset(400, 16),
		TextXAlignment = Enum.TextXAlignment.Left,
		RichText = true,
		TextStrokeTransparency = 0.4,
	})

	-- босс
	self.boss = Ui.panel(safe, {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0),
		Size = UDim2.fromOffset(240, 34),
		Visible = false,
	})
	Ui.label(self.boss, "Гу", 13, { Size = UDim2.new(1, 0, 0, 14), Position = UDim2.fromOffset(0, 2) })
	local bossBack = Ui.new("Frame", {
		BackgroundColor3 = Ui.C.hpBack,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 8, 0, 18),
		Size = UDim2.new(1, -16, 0, 10),
		Parent = self.boss,
	})
	self.bossFill = Ui.new("Frame", { BackgroundColor3 = Ui.C.hp, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), Parent = bossBack })

	-- меню и масштаб
	local right = Ui.new("Frame", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.fromOffset(44, 140),
		BackgroundTransparency = 1,
		Parent = safe,
	})
	Ui.new("UIListLayout", { Padding = UDim.new(0, 6), Parent = right })
	Ui.button(right, "≡", on.menu, { Size = UDim2.fromOffset(44, 40), TextSize = 22 })
	Ui.button(right, "+", function()
		on.zoom(1)
	end, { Size = UDim2.fromOffset(44, 36), TextSize = 22 })
	Ui.button(right, "−", function()
		on.zoom(-1)
	end, { Size = UDim2.fromOffset(44, 36), TextSize = 22 })

	-- панель кнопок
	local bar = Ui.new("Frame", {
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.fromScale(1, 1),
		Size = UDim2.fromOffset(3 * 60, 56),
		BackgroundTransparency = 1,
		Parent = safe,
	})
	Ui.new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Right,
		Padding = UDim.new(0, 4),
		Parent = bar,
	})
	local function toolButton(icon, onClick)
		local b = Ui.button(bar, "", onClick, { Size = UDim2.fromOffset(56, 56) })
		local r = Ui.Atlas.rects[icon]
		local img = Ui.image(b, {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(r.w * 2, r.h * 2),
		})
		Ui.setRect(img, r.x, r.y, r.w, r.h)
		return b
	end
	self.btnSearch = toolButton("icon_search", on.examine)
	self.btnWait = toolButton("icon_wait", nil)
	self.btnBag = toolButton("icon_bag", on.inventory)
	if not Ui.atlas then
		self.btnSearch.Text, self.btnWait.Text, self.btnBag.Text = "?", "Zz", "Рюк"
	end
	-- «ждать»: нажатие — один ход, удержание — отдых до полного здоровья
	local holdStart
	self.btnWait.MouseButton1Down:Connect(function()
		holdStart = os.clock()
		task.delay(0.5, function()
			if holdStart and os.clock() - holdStart >= 0.45 then
				holdStart = nil
				on.rest()
			end
		end)
	end)
	self.btnWait.MouseButton1Up:Connect(function()
		if holdStart then
			holdStart = nil
			on.wait()
		end
	end)

	-- индикатор врага: нажать — атаковать ближайшего
	self.attack = Ui.button(safe, "", on.attackNearest, {
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, 0, 1, -62),
		Size = UDim2.fromOffset(56, 56),
		BackgroundColor3 = Color3.fromRGB(110, 40, 35),
		Visible = false,
	})
	self.attackImg = Ui.image(self.attack, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(40, 40),
	})

	-- журнал
	self.logFrame = Ui.new("Frame", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, -200, 0, LOG_LINES * 19),
		BackgroundTransparency = 1,
		Parent = safe,
	})
	Ui.new("UIListLayout", {
		VerticalAlignment = Enum.VerticalAlignment.Bottom,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = self.logFrame,
	})
	self.logOrder = 0
	return self
end

function Hud:log(text, color)
	self.logOrder = self.logOrder + 1
	local l = Ui.label(self.logFrame, text, 15, {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Ui.LOG[color] or Ui.C.text,
		TextStrokeTransparency = 0.3,
		LayoutOrder = self.logOrder,
	})
	table.insert(self.lines, { label = l, born = os.clock() })
	while #self.lines > LOG_LINES do
		table.remove(self.lines, 1).label:Destroy()
	end
end

function Hud:clearLog()
	for _, l in ipairs(self.lines) do
		l.label:Destroy()
	end
	self.lines = {}
end

function Hud:update()
	local now = os.clock()
	for _, l in ipairs(self.lines) do
		local age = now - l.born
		local fade = math.clamp((age - 8) / 4, 0, 0.85)
		l.label.TextTransparency = fade
		l.label.TextStrokeTransparency = 0.3 + fade * 0.7
	end
end

function Hud:setExamine(on)
	self.btnSearch.BackgroundColor3 = on and Color3.fromRGB(140, 120, 50) or Ui.C.button
end

function Hud:refresh(g)
	local hero = g.hero
	local tier = hero.armor and Defs.armors[hero.armor.type].tier or 0
	local x, y, w, h = Ui.charFrame("warrior", 0, tier)
	Ui.setRect(self.portrait, x, y, w, h)
	self.title.Text = string.format("Воин · ур. %d · сила %d", hero.lvl, hero.str)
	self.hpFill.Size = UDim2.fromScale(math.clamp(hero.hp / hero.ht, 0, 1), 1)
	self.hpText.Text = string.format("%d/%d", math.max(0, hero.hp), hero.ht)
	self.expFill.Size = UDim2.fromScale(math.clamp(hero.exp / (5 + hero.lvl * 5), 0, 1), 1)
	self.info.Text = string.format("Глубина %d · золото %d", g.depth, hero.gold)
	local parts = {}
	local hex = { white = "#F0ECE4", good = "#6EF06E", bad = "#FF5F5F", warn = "#FFAA3C", high = "#FFF05A" }
	for _, b in ipairs(g:heroInfo()) do
		parts[#parts + 1] = string.format('<font color="%s">%s</font>', hex[b.color] or hex.white, b.text)
	end
	self.buffs.Text = table.concat(parts, "  ")

	local enemies = g:visibleEnemies()
	self.attack.Visible = #enemies > 0 and not g.over
	if #enemies > 0 then
		local m = enemies[1]
		local fx, fy, fw, fh = Ui.charFrame(m.def.sprite, 0, 0)
		Ui.setRect(self.attackImg, fx, fy, fw, fh)
		local k = 40 / math.max(fw, fh)
		self.attackImg.Size = UDim2.fromOffset(fw * k, fh * k)
	end

	local boss
	for _, m in ipairs(g.mobs) do
		if m.boss then
			boss = m
		end
	end
	self.boss.Visible = boss ~= nil and boss.state ~= "sleeping" and g.depth == g.MAX_DEPTH
	if boss then
		self.bossFill.Size = UDim2.fromScale(math.clamp(boss.hp / boss.ht, 0, 1), 1)
	end
end

------------------------------------------------------------------ окна

-- значок предмета в ячейке
local function itemSlot(parent, g, item, size, onClick, hint)
	local b = Ui.button(parent, "", onClick, {
		Size = UDim2.fromOffset(size, size),
		BackgroundColor3 = item and Ui.C.button or Ui.C.panelDark,
		ZIndex = 53,
	})
	if item then
		local img = Ui.image(b, {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(32, 32),
			ZIndex = 54,
		})
		Ui.setItemIcon(img, g:itemIcon(item))
		if not Ui.atlas then
			b.Text = string.sub(g:itemName(item), 1, 6)
			b.TextSize = 10
		end
		local corner = ""
		if item.qty > 1 then
			corner = tostring(item.qty)
		end
		if (item.kind == "weapon" or item.kind == "armor") then
			if not item.known then
				corner = "?"
			elseif item.level ~= 0 then
				corner = (item.level > 0 and "+" or "") .. item.level
			end
		end
		if corner ~= "" then
			Ui.label(b, corner, 13, {
				AnchorPoint = Vector2.new(1, 1),
				Position = UDim2.new(1, -3, 1, -1),
				Size = UDim2.fromOffset(30, 14),
				TextXAlignment = Enum.TextXAlignment.Right,
				TextStrokeTransparency = 0.3,
				TextColor3 = corner == "?" and Ui.LOG.warn or Ui.C.text,
				ZIndex = 55,
			})
		end
	elseif hint then
		local img = Ui.image(b, {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(32, 32),
			ImageTransparency = 0.6,
			ZIndex = 54,
		})
		Ui.setItemIcon(img, hint)
	end
	return b
end

-- рюкзак. pick(item, equipped) вызывается по нажатию; filter оставляет только подходящие
function Hud:inventory(g, title, pick, filter)
	local win = Ui.window(self.gui, title or "Рюкзак", 360)
	local hero = g.hero
	local size = 56
	local top = Ui.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, size),
		LayoutOrder = win.next(),
		ZIndex = 52,
		Parent = win.frame,
	})
	Ui.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), Parent = top })
	local function slot(parent, item, equipped, hint)
		local usable = item and (not filter or filter(item))
		local b = itemSlot(parent, g, item, size, function()
			if usable then
				win.close()
				pick(item, equipped)
			end
		end, hint)
		if item and not usable then
			b.BackgroundTransparency = 0.6
		end
	end
	slot(top, hero.weapon, true, Defs.ICON_WEAPON_SLOT)
	slot(top, hero.armor, true, Defs.ICON_ARMOR_SLOT)
	Ui.label(top, string.format("Золото: %d", hero.gold), 15, {
		Size = UDim2.new(1, -2 * (size + 6), 1, 0),
		TextColor3 = Ui.C.gold,
		TextXAlignment = Enum.TextXAlignment.Right,
		ZIndex = 53,
	})
	local grid = Ui.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 4 * (size + 6)),
		LayoutOrder = win.next(),
		ZIndex = 52,
		Parent = win.frame,
	})
	Ui.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(size, size),
		CellPadding = UDim2.fromOffset(6, 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = grid,
	})
	for i = 1, g.BAG_SIZE do
		slot(grid, hero.bag[i], false)
	end
	win.buttons({ { "Закрыть", function() end } })
	return win
end

-- окно предмета с действиями
function Hud:itemWindow(g, item, equipped, onAction)
	local win = Ui.window(self.gui, nil, 380)
	local head = Ui.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 40),
		LayoutOrder = win.next(),
		ZIndex = 52,
		Parent = win.frame,
	})
	local img = Ui.image(head, { Size = UDim2.fromOffset(32, 32), Position = UDim2.fromOffset(0, 4), ZIndex = 53 })
	Ui.setItemIcon(img, g:itemIcon(item))
	local name = g:itemName(item)
	if item.qty > 1 then
		name = name .. " ×" .. item.qty
	end
	Ui.label(head, name, 18, {
		Position = UDim2.fromOffset(42, 0),
		Size = UDim2.new(1, -42, 1, 0),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Ui.LOG.high,
		TextWrapped = true,
		ZIndex = 53,
	})
	win.text(g:itemDesc(item))
	local buttons = {}
	for _, a in ipairs(g:itemActions(item, equipped)) do
		buttons[#buttons + 1] = { a.label, function()
			onAction(a.id)
		end }
	end
	buttons[#buttons + 1] = { "Закрыть", function() end }
	win.buttons(buttons)
	return win
end

function Hud:message(title, text, buttons, width)
	local win = Ui.window(self.gui, title, width or 420)
	if text then
		win.text(text)
	end
	win.buttons(buttons or { { "OK", function() end } })
	return win
end

return Hud
]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX00000000000000000000000000000016">
						<Properties>
							<string name="Name">Ui</string>
							<ProtectedString name="Source"><![CDATA[-- Общие помощники интерфейса: создание объектов, окна, кнопки, картинки из атласа.
local Ui = {}

Ui.FONT = Enum.Font.GothamBold
Ui.FONT_REGULAR = Enum.Font.Gotham

Ui.C = {
	panel = Color3.fromRGB(48, 43, 38),
	panelDark = Color3.fromRGB(28, 25, 23),
	border = Color3.fromRGB(110, 97, 78),
	button = Color3.fromRGB(82, 72, 60),
	buttonDown = Color3.fromRGB(62, 54, 45),
	text = Color3.fromRGB(240, 236, 228),
	dim = Color3.fromRGB(170, 160, 145),
	hp = Color3.fromRGB(200, 40, 40),
	hpBack = Color3.fromRGB(70, 20, 20),
	exp = Color3.fromRGB(255, 220, 60),
	gold = Color3.fromRGB(255, 210, 70),
}

-- цвета журнала как в GLog
Ui.LOG = {
	white = Color3.fromRGB(240, 236, 228),
	good = Color3.fromRGB(110, 240, 110),
	bad = Color3.fromRGB(255, 95, 95),
	warn = Color3.fromRGB(255, 170, 60),
	high = Color3.fromRGB(255, 240, 90),
}

-- картинка атласа: { image = "rbxassetid://..." } или { content = Content } или nil
Ui.atlas = nil
Ui.Atlas = nil -- модуль с координатами

function Ui.new(class, props, children)
	local inst = Instance.new(class)
	for k, v in pairs(props or {}) do
		if k ~= "Parent" then
			inst[k] = v
		end
	end
	for _, c in ipairs(children or {}) do
		c.Parent = inst
	end
	if props and props.Parent then
		inst.Parent = props.Parent
	end
	return inst
end

function Ui.corner(parent, r)
	return Ui.new("UICorner", { CornerRadius = UDim.new(0, r or 6), Parent = parent })
end

function Ui.stroke(parent, color, thickness)
	return Ui.new("UIStroke", {
		Color = color or Ui.C.border,
		Thickness = thickness or 2,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = parent,
	})
end

function Ui.panel(parent, props)
	props = props or {}
	props.BackgroundColor3 = props.BackgroundColor3 or Ui.C.panel
	props.BorderSizePixel = 0
	props.Parent = parent
	local f = Ui.new("Frame", props)
	Ui.corner(f, 6)
	Ui.stroke(f)
	return f
end

function Ui.label(parent, text, size, props)
	props = props or {}
	props.Text = text
	props.TextSize = size or 16
	props.Font = props.Font or Ui.FONT
	props.TextColor3 = props.TextColor3 or Ui.C.text
	props.BackgroundTransparency = 1
	props.Parent = parent
	local l = Ui.new("TextLabel", props)
	return l
end

function Ui.button(parent, text, onClick, props)
	props = props or {}
	props.Text = text
	props.TextSize = props.TextSize or 18
	props.Font = Ui.FONT
	props.TextColor3 = Ui.C.text
	props.BackgroundColor3 = props.BackgroundColor3 or Ui.C.button
	props.AutoButtonColor = true
	props.BorderSizePixel = 0
	props.Parent = parent
	local b = Ui.new("TextButton", props)
	Ui.corner(b, 6)
	Ui.stroke(b)
	if onClick then
		b.Activated:Connect(onClick)
	end
	return b
end

-- картинка из атласа; без атласа — цветной квадрат с буквой
function Ui.image(parent, props)
	props = props or {}
	props.BackgroundTransparency = props.BackgroundTransparency or 1
	props.BorderSizePixel = 0
	props.Parent = parent
	local img = Ui.new("ImageLabel", props)
	img.ResampleMode = Enum.ResamplerMode.Pixelated
	if Ui.atlas then
		if Ui.atlas.image then
			img.Image = Ui.atlas.image
		else
			img.ImageContent = Ui.atlas.content
		end
	end
	return img
end

function Ui.setRect(img, x, y, w, h, flip)
	if flip then
		img.ImageRectOffset = Vector2.new(x + w, y)
		img.ImageRectSize = Vector2.new(-w, h)
	else
		img.ImageRectOffset = Vector2.new(x, y)
		img.ImageRectSize = Vector2.new(w, h)
	end
end

-- значок предмета по номеру из ItemSpriteSheet
function Ui.setItemIcon(img, icon)
	local r = Ui.Atlas.rects.items
	Ui.setRect(img, r.x + (icon % 16) * 16, r.y + math.floor(icon / 16) * 16, 16, 16)
end

-- кадр персонажа: sprite — имя в атласе, row — ряд (для героя это тир брони)
function Ui.charFrame(sprite, frame, row)
	local r = Ui.Atlas.rects[sprite]
	local f = Ui.Atlas.film[sprite]
	local col = frame % f.cols
	local line = math.floor(frame / f.cols) + (row or 0)
	return r.x + col * f.fw, r.y + line * f.fh, f.fw, f.fh
end

-- модальное окно поверх экрана
function Ui.window(gui, title, width, onClose)
	local shade = Ui.new("TextButton", {
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.45,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 50,
		Parent = gui,
	})
	local frame = Ui.panel(shade, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(0, math.min(width or 420, 600), 0, 100),
		AutomaticSize = Enum.AutomaticSize.Y,
		ZIndex = 51,
	})
	-- на маленьких экранах окно уменьшается, чтобы влезть целиком
	local scale = Ui.new("UIScale", { Scale = 1, Parent = frame })
	local function fit()
		local s = scale.Scale
		local w, h = frame.AbsoluteSize.X / s, frame.AbsoluteSize.Y / s
		local vw, vh = gui.AbsoluteSize.X, gui.AbsoluteSize.Y
		if w > 0 and h > 0 then
			local k = math.min(1, (vw - 16) / w, (vh - 16) / h)
			if math.abs(k - s) > 0.01 then
				scale.Scale = k
			end
		end
	end
	frame:GetPropertyChangedSignal("AbsoluteSize"):Connect(fit)
	task.defer(fit)
	Ui.new("UIPadding", {
		PaddingTop = UDim.new(0, 12),
		PaddingBottom = UDim.new(0, 12),
		PaddingLeft = UDim.new(0, 14),
		PaddingRight = UDim.new(0, 14),
		Parent = frame,
	})
	Ui.new("UIListLayout", {
		Padding = UDim.new(0, 10),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Parent = frame,
	})
	local win = { shade = shade, frame = frame, order = 0 }
	function win.close()
		shade:Destroy()
		if onClose then
			onClose()
		end
	end
	function win.next()
		win.order = win.order + 1
		return win.order
	end
	if title then
		Ui.label(frame, title, 20, {
			Size = UDim2.new(1, 0, 0, 24),
			TextColor3 = Ui.LOG.high,
			TextWrapped = true,
			AutomaticSize = Enum.AutomaticSize.Y,
			LayoutOrder = win.next(),
			ZIndex = 52,
		})
	end
	function win.text(text, size, color)
		return Ui.label(frame, text, size or 15, {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			Font = Ui.FONT_REGULAR,
			TextColor3 = color or Ui.C.text,
			LayoutOrder = win.next(),
			ZIndex = 52,
		})
	end
	function win.buttons(list)
		local row = Ui.new("Frame", {
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, 40),
			LayoutOrder = win.next(),
			ZIndex = 52,
			Parent = frame,
		})
		Ui.new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			Padding = UDim.new(0, 8),
			Parent = row,
		})
		local n = #list
		for _, b in ipairs(list) do
			Ui.button(row, b[1], function()
				if b[3] ~= false then
					win.close()
				end
				b[2]()
			end, { Size = UDim2.new(1 / n, -8, 1, 0), ZIndex = 53, TextSize = 16 })
		end
		return row
	end
	return win
end

return Ui
]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX00000000000000000000000000000017">
						<Properties>
							<string name="Name">View</string>
							<ProtectedString name="Source"><![CDATA[-- Отрисовка подземелья: тайлы, туман войны, предметы на полу, персонажи с анимациями,
-- всплывающий текст, камера. Всё — ImageLabel'ы из одного атласа с пикселями без сглаживания.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("BPD")
local Core = Shared:WaitForChild("Core")
local Tiles = require(Core:WaitForChild("Tiles"))
local Terrain = require(Core:WaitForChild("Terrain"))
local Defs = require(Core:WaitForChild("Defs"))
local Ui = require(script.Parent:WaitForChild("Ui"))

local T = Terrain
local View = {}
View.__index = View

local WHITE = Color3.new(1, 1, 1)
local FOG = Color3.fromRGB(105, 105, 118)
local MAPPED = Color3.fromRGB(60, 72, 96)
local MOVE_TIME = 0.1
local RAISE = 6 -- персонажи приподняты на 6 пикселей, как в SPD (perspectiveRaise)

-- цвета клеток, если атласа нет
local FALLBACK = {
	[T.EMPTY] = Color3.fromRGB(80, 78, 74),
	[T.EMPTY_DECO] = Color3.fromRGB(86, 82, 76),
	[T.GRASS] = Color3.fromRGB(70, 100, 50),
	[T.HIGH_GRASS] = Color3.fromRGB(50, 120, 40),
	[T.FURROWED_GRASS] = Color3.fromRGB(80, 110, 50),
	[T.WATER] = Color3.fromRGB(50, 95, 100),
	[T.DOOR] = Color3.fromRGB(130, 85, 40),
	[T.OPEN_DOOR] = Color3.fromRGB(90, 60, 30),
	[T.ENTRANCE] = Color3.fromRGB(150, 150, 60),
	[T.EXIT] = Color3.fromRGB(200, 170, 40),
	[T.WALL] = Color3.fromRGB(150, 150, 155),
	[T.WALL_DECO] = Color3.fromRGB(150, 150, 155),
}

function View.new(parent, zoom)
	local self = setmetatable({}, View)
	self.zoom = zoom
	self.root = Ui.new("Frame", {
		Name = "World",
		BackgroundColor3 = Color3.new(0, 0, 0),
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		ClipsDescendants = true,
		Parent = parent,
	})
	self.sprites = {}
	self.camX, self.camY = nil, nil
	self.shake = 0
	return self
end

function View:S()
	return 16 * self.zoom
end

local function layer(parent, name, z)
	return Ui.new("Frame", {
		Name = name,
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ZIndex = z,
		Parent = parent,
	})
end

-- полностью перестроить вид для текущего этажа
function View:load(g)
	self.g = g
	if self.map then
		self.map:Destroy()
	end
	local lvl = g.level
	local S = self:S()
	self.map = Ui.new("Frame", {
		Name = "Map",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(lvl.w * S, lvl.h * S),
		Parent = self.root,
	})
	self.lWater = layer(self.map, "Water", 1)
	self.lGround = layer(self.map, "Ground", 2)
	self.lHeaps = layer(self.map, "Heaps", 3)
	self.lChars = layer(self.map, "Chars", 4)
	self.lUpper = layer(self.map, "Upper", 5)
	self.lFx = layer(self.map, "Fx", 6)
	self.ground, self.upper, self.water, self.heapLabels = {}, {}, {}, {}
	self.fogState = {}
	self.sprites = {}
	for i = 1, lvl.w * lvl.h do
		self:buildCell(i)
	end
	self:refreshFog()
	self:refreshHeaps()
	self:addSprite(g.hero)
	for _, m in ipairs(g.mobs) do
		self:addSprite(m)
	end
	self.camX = nil
	self:updateVisibility()
end

function View:cellPos(i)
	local w = self.g.level.w
	return (i - 1) % w, math.floor((i - 1) / w)
end

-- создать/обновить подписи клетки i
function View:buildCell(i)
	local lvl = self.g.level
	local map, w, h = lvl.map, lvl.w, lvl.h
	local S = self:S()
	local x, y = self:cellPos(i)
	local pos = UDim2.fromOffset(x * S, y * S)
	local size = UDim2.fromOffset(S, S)
	local t = map[i]

	if t == T.WATER and not self.water[i] then
		local wl = Ui.image(self.lWater, { Position = pos, Size = size })
		local r = Ui.Atlas.rects.water
		Ui.setRect(wl, r.x + (x % 2) * 16, r.y + (y % 2) * 16, 16, 16)
		if not Ui.atlas then
			wl:SetAttribute("solid", true)
			wl.BackgroundTransparency = 0
			wl.BackgroundColor3 = FALLBACK[T.WATER]
		end
		self.water[i] = wl
	elseif t ~= T.WATER and self.water[i] then
		self.water[i]:Destroy()
		self.water[i] = nil
	end

	local gv = Tiles.ground(map, w, h, i, lvl.variance[i])
	local below = (i + w <= w * h) and lvl.variance[i + w] or 0
	local uv = Tiles.upper(map, w, h, i, lvl.variance[i], below)
	self:setTile(self.ground, self.lGround, i, gv, pos, size, t)
	self:setTile(self.upper, self.lUpper, i, uv, pos, size, nil)
end

function View:setTile(store, parent, i, visual, pos, size, terrain)
	local label = store[i]
	if visual < 0 then
		if label then
			label:Destroy()
			store[i] = nil
		end
		return
	end
	if not label then
		label = Ui.image(parent, { Position = pos, Size = size })
		store[i] = label
	end
	local r = Ui.Atlas.rects.tiles
	Ui.setRect(label, r.x + (visual % 16) * 16, r.y + math.floor(visual / 16) * 16, 16, 16)
	if not Ui.atlas and terrain and terrain ~= T.WATER then
		label:SetAttribute("solid", true)
		label.BackgroundTransparency = 0
		label.BackgroundColor3 = FALLBACK[terrain] or Color3.fromRGB(60, 60, 60)
	end
	self.fogState[i] = nil
end

-- клетка изменилась (дверь, трава): пересчитать её и соседей — у тайлов есть стыки
function View:tileChanged(i)
	local w, h = self.g.level.w, self.g.level.h
	local x, y = self:cellPos(i)
	for dy = -1, 1 do
		for dx = -1, 1 do
			local nx, ny = x + dx, y + dy
			if nx >= 0 and ny >= 0 and nx < w and ny < h then
				self:buildCell(ny * w + nx + 1)
			end
		end
	end
	self:refreshFog()
end

function View:refreshFog()
	local g = self.g
	local n = g.level.w * g.level.h
	for i = 1, n do
		local state = g.fov[i] and 3 or (g.visited[i] and 2 or (g.mapped[i] and 1 or 0))
		if self.fogState[i] ~= state then
			self.fogState[i] = state
			local color = state == 3 and WHITE or (state == 2 and FOG or MAPPED)
			local visible = state > 0
			for _, store in ipairs({ self.ground, self.upper, self.water }) do
				local l = store[i]
				if l then
					l.Visible = visible
					l.ImageColor3 = color
					if l:GetAttribute("solid") then
						l.BackgroundTransparency = state == 3 and 0 or (state == 2 and 0.45 or 0.7)
					end
				end
			end
		end
	end
end

function View:refreshHeaps()
	local g = self.g
	local S = self:S()
	for pos, label in pairs(self.heapLabels) do
		if not g.heaps[pos] then
			label:Destroy()
			self.heapLabels[pos] = nil
		end
	end
	for pos, heap in pairs(g.heaps) do
		local top = heap[#heap]
		if top then
			local label = self.heapLabels[pos]
			if not label then
				local x, y = self:cellPos(pos)
				label = Ui.image(self.lHeaps, {
					Position = UDim2.fromOffset(x * S, y * S - 3 * self.zoom),
					Size = UDim2.fromOffset(S, S),
				})
				self.heapLabels[pos] = label
			end
			Ui.setItemIcon(label, g:itemIcon(top))
			if not Ui.atlas then
				label.BackgroundTransparency = 0.2
				label.BackgroundColor3 = Ui.C.gold
				label.Size = UDim2.fromOffset(S / 2, S / 2)
			end
			label.Visible = g.visited[pos] == true
			label.ImageColor3 = g.fov[pos] and WHITE or FOG
		end
	end
end

------------------------------------------------------------------ персонажи

function View:spriteInfo(ch)
	if ch.isHero then
		local tier = ch.armor and Defs.armors[ch.armor.type].tier or 0
		return Defs.hero.sprite, Defs.hero.anim, tier
	end
	return ch.def.sprite, ch.def.anim, 0
end

function View:addSprite(ch)
	local sprite, anims, row = self:spriteInfo(ch)
	local f = Ui.Atlas.film[sprite]
	local z = self.zoom
	local label = Ui.image(self.lChars, { Size = UDim2.fromOffset(f.fw * z, f.fh * z), ZIndex = 2 })
	local s = {
		ch = ch,
		label = label,
		sprite = sprite,
		anims = anims,
		row = row,
		film = f,
		flip = false,
		pos = ch.pos,
		t = 0,
	}
	if not Ui.atlas then
		label.BackgroundTransparency = 0
		label.BackgroundColor3 = ch.isHero and Color3.fromRGB(230, 120, 60) or Color3.fromRGB(170, 60, 60)
		Ui.label(label, ch.isHero and "@" or string.upper(string.sub(ch.type, 1, 1)), 12 * z / 2, { Size = UDim2.fromScale(1, 1) })
	end
	if not ch.isHero then
		local bar = Ui.new("Frame", {
			BackgroundColor3 = Ui.C.hpBack,
			BorderSizePixel = 0,
			Size = UDim2.fromOffset(12 * z, 2 * z),
			Visible = false,
			ZIndex = 3,
			Parent = self.lChars,
		})
		Ui.new("Frame", { Name = "Fill", BackgroundColor3 = Ui.C.hp, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), Parent = bar })
		s.bar = bar
	end
	self.sprites[ch.id] = s
	self:play(s, "idle")
	self:placeSprite(s, ch.pos)
	return s
end

function View:spritePixel(s, pos)
	local x, y = self:cellPos(pos)
	local f = s.film
	return x * 16 + (16 - f.fw) / 2, (y + 1) * 16 - f.fh - RAISE
end

function View:placeSprite(s, pos)
	local px, py = self:spritePixel(s, pos)
	s.px, s.py = px, py
	self:applySpritePos(s)
end

function View:applySpritePos(s)
	local z = self.zoom
	s.label.Position = UDim2.fromOffset(math.floor(s.px * z + 0.5), math.floor(s.py * z + 0.5))
	if s.bar then
		s.bar.Position = UDim2.fromOffset(math.floor((s.px + (s.film.fw - 12) / 2) * z), math.floor((s.py - 3) * z))
	end
end

function View:play(s, name, onDone)
	local a = s.anims[name] or s.anims.idle
	s.anim = a
	s.animName = name
	s.t = 0
	s.loop = name == "idle" or name == "run" or name == "pump"
	s.onDone = onDone
	self:setFrame(s, a[2][1])
end

function View:setFrame(s, frame)
	if s.frame == frame then
		return
	end
	s.frame = frame
	local x, y, w, h = Ui.charFrame(s.sprite, frame, s.row)
	Ui.setRect(s.label, x, y, w, h, s.flip)
end

function View:turnTo(s, from, to)
	local fx = self:cellPos(from)
	local tx = self:cellPos(to)
	if tx ~= fx then
		local flip = tx < fx
		if flip ~= s.flip then
			s.flip = flip
			s.frame = nil
		end
	end
end

function View:updateVisibility()
	local g = self.g
	for id, s in pairs(self.sprites) do
		local ch = s.ch
		local vis = ch.isHero or (not s.dying and g:mobVisible(ch)) or s.dying == true and g.fov[s.pos]
		s.label.Visible = vis and true or false
		if s.bar then
			s.bar.Visible = vis and ch.hp < ch.ht and ch.hp > 0 and not s.dying
			s.bar.Fill.Size = UDim2.fromScale(math.clamp(ch.hp / ch.ht, 0, 1), 1)
		end
		if ch.isHero then
			s.label.ImageTransparency = g.hero.buffs.invisible and 0.6 or 0
		end
	end
end

-- всплывающий текст над персонажем
function View:floatText(id, text, color)
	local s = self.sprites[id]
	if not s or not s.label.Visible then
		return
	end
	local z = self.zoom
	local l = Ui.label(self.lFx, text, math.max(12, 5 * z), {
		TextColor3 = color,
		TextStrokeTransparency = 0.2,
		Size = UDim2.fromOffset(0, 0),
		AutomaticSize = Enum.AutomaticSize.XY,
		AnchorPoint = Vector2.new(0.5, 1),
	})
	local x0, y0 = (s.px + s.film.fw / 2) * z, s.py * z
	self.floats = self.floats or {}
	-- не налезать на предыдущие надписи этого персонажа
	local stack = 0
	for _, f in ipairs(self.floats) do
		if f.id == id and f.t < 0.3 then
			stack = stack + 1
		end
	end
	table.insert(self.floats, { label = l, t = 0, x = x0, y = y0 - stack * 6 * z, id = id })
end

------------------------------------------------------------------ события ядра

function View:handle(e)
	local g = self.g
	if not self.map then
		return
	end
	if e.type == "move" then
		local s = self.sprites[e.id]
		if s then
			self:turnTo(s, e.from, e.to)
			s.pos = e.to
			s.fromX, s.fromY = s.px, s.py
			s.toX, s.toY = self:spritePixel(s, e.to)
			s.moveT = 0
			if s.animName ~= "attack" then
				self:play(s, "run")
			end
		end
	elseif e.type == "attack" then
		local s = self.sprites[e.id]
		if s then
			self:turnTo(s, s.pos, e.target)
			self:play(s, "attack", function()
				self:play(s, "idle")
			end)
		end
	elseif e.type == "damage" then
		local s = self.sprites[e.id]
		if s then
			s.flash = 0.15
			self:floatText(e.id, e.amount > 0 and tostring(e.amount) or "0", Ui.LOG.bad)
		end
	elseif e.type == "heal" then
		self:floatText(e.id, "+" .. e.amount, Ui.LOG.good)
	elseif e.type == "status" then
		self:floatText(e.id, e.text, Ui.LOG[e.color] or Ui.C.text)
	elseif e.type == "spawn" then
		local m = g:findChar(e.id)
		if m and not self.sprites[e.id] and self.map then
			self:addSprite(m)
		end
	elseif e.type == "die" then
		local s = self.sprites[e.id]
		if s then
			s.dying = true
			s.label.Visible = g.fov[s.pos] == true
			if s.bar then
				s.bar.Visible = false
			end
			self:play(s, "die", function()
				s.fade = 0
			end)
		end
	elseif e.type == "pump" then
		local s = self.sprites[e.id]
		if s then
			if e.level > 0 then
				self:play(s, "pump")
				s.label.ImageColor3 = e.level >= 2 and Color3.fromRGB(255, 120, 120) or Color3.fromRGB(255, 190, 190)
			else
				s.label.ImageColor3 = WHITE
				if s.animName == "pump" then
					self:play(s, "idle")
				end
			end
		end
	elseif e.type == "tile" then
		self:tileChanged(e.pos)
	elseif e.type == "fov" then
		self:refreshFog()
		self:refreshHeaps()
		self:updateVisibility()
	elseif e.type == "heap" then
		self:refreshHeaps()
	elseif e.type == "shake" then
		self.shake = 0.25
	elseif e.type == "teleport" then
		local s = self.sprites[0]
		if s then
			s.moveT = nil
			self:placeSprite(s, g.hero.pos)
		end
		self.camX = nil
	elseif e.type == "hero" then
		local s = self.sprites[0]
		if s then
			local _, _, row = self:spriteInfo(g.hero)
			if row ~= s.row then
				s.row = row
				s.frame = nil
			end
		end
		self:updateVisibility()
	end
end

------------------------------------------------------------------ кадр

function View:update(dt)
	if not self.map then
		return
	end
	local z = self.zoom
	for id, s in pairs(self.sprites) do
		-- анимация
		local a = s.anim
		s.t = s.t + dt
		local frames = a[2]
		local idx = math.floor(s.t * a[1])
		if s.loop then
			self:setFrame(s, frames[idx % #frames + 1])
		elseif idx >= #frames then
			self:setFrame(s, frames[#frames])
			local cb = s.onDone
			s.onDone = nil
			if cb then
				cb()
			end
		else
			self:setFrame(s, frames[idx + 1])
		end
		-- движение
		if s.moveT then
			s.moveT = s.moveT + dt
			local k = math.min(1, s.moveT / MOVE_TIME)
			s.px = s.fromX + (s.toX - s.fromX) * k
			s.py = s.fromY + (s.toY - s.fromY) * k
			if k >= 1 then
				s.moveT = nil
				if s.animName == "run" then
					self:play(s, "idle")
				end
			end
			self:applySpritePos(s)
		end
		if s.flash then
			s.flash = s.flash - dt
			if s.animName ~= "pump" then
				s.label.ImageColor3 = s.flash > 0 and Color3.fromRGB(255, 150, 150) or WHITE
			end
			if s.flash <= 0 then
				s.flash = nil
			end
		end
		if s.fade then
			s.fade = s.fade + dt
			s.label.ImageTransparency = math.min(1, s.fade / 0.4)
			if s.fade >= 0.4 then
				s.label:Destroy()
				if s.bar then
					s.bar:Destroy()
				end
				self.sprites[id] = nil
			end
		end
	end

	-- всплывающий текст
	if self.floats then
		for i = #self.floats, 1, -1 do
			local f = self.floats[i]
			f.t = f.t + dt
			f.label.Position = UDim2.fromOffset(f.x, f.y - f.t * 10 * z)
			f.label.TextTransparency = math.max(0, (f.t - 0.6) / 0.6)
			f.label.TextStrokeTransparency = 0.2 + 0.8 * math.max(0, (f.t - 0.6) / 0.6)
			if f.t > 1.2 then
				f.label:Destroy()
				table.remove(self.floats, i)
			end
		end
	end

	-- камера следует за героем
	local hero = self.sprites[0]
	if hero then
		local vw, vh = self.root.AbsoluteSize.X, self.root.AbsoluteSize.Y
		local tx = vw / 2 - (hero.px + hero.film.fw / 2) * z
		local ty = vh / 2 - (hero.py + hero.film.fh / 2) * z
		if not self.camX then
			self.camX, self.camY = tx, ty
		else
			local k = math.min(1, dt * 8)
			self.camX = self.camX + (tx - self.camX) * k
			self.camY = self.camY + (ty - self.camY) * k
		end
		local ox, oy = 0, 0
		if self.shake > 0 then
			self.shake = self.shake - dt
			ox, oy = math.random(-3, 3) * z / 2, math.random(-3, 3) * z / 2
		end
		self.map.Position = UDim2.fromOffset(math.floor(self.camX + ox), math.floor(self.camY + oy))
	end
end

-- клетка под точкой экрана (координаты внутри ScreenGui)
function View:cellAt(screen)
	if not self.map or not self.camX then
		return nil
	end
	local S = self:S()
	local local_ = screen - self.root.AbsolutePosition
	local x = math.floor((local_.X - self.camX) / S)
	local y = math.floor((local_.Y - self.camY) / S)
	local lvl = self.g.level
	if x < 0 or y < 0 or x >= lvl.w or y >= lvl.h then
		return nil
	end
	return y * lvl.w + x + 1
end

return View
]]></ProtectedString>
						</Properties>
					</Item>
				</Item>
			</Item>
		</Item>
	</Item>
</roblox>
